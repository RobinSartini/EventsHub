{
  "name": "EventsHub",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.6.5",
      "@types/bun": "^1.4.2",
      "hono": "^4.12.27",
      "@trpc/server": "^11.19.0",
      "better-auth": "1.6.22",
      "react": "19.2.8",
      "@types/react": "~19.2.18",
      "vitest": "4.1.8",
      "@vitest/ui": "4.1.8",
      "@vitest/coverage-v8": "4.1.8",
      "jsdom": "^29.1.1",
      "react-dom": "19.2.8",
      "@trpc/client": "^11.19.0",
      "tailwindcss": "^4.3.3",
      "@types/node": "^26.6.4",
      "@types/react-dom": "~19.2.7",
      "@prisma/client": "^7.10.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev-setup.ts && vp run -r --parallel dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "docker:up": "bun scripts/docker.ts up",
    "docker:down": "bun scripts/docker.ts down",
    "docker:reset": "bun scripts/docker.ts reset",
    "dev:web": "vp run --fail-if-no-match --filter web dev",
    "dev:docs": "vp run --fail-if-no-match --filter fumadocs dev",
    "build:docs": "vp run --fail-if-no-match --filter fumadocs build",
    "check:docs": "vp run --fail-if-no-match --filter fumadocs types:check",
    "dev:server": "vp run --fail-if-no-match --filter server dev",
    "ios": "bash scripts/native/run.sh",
    "ios:logs": "xcrun simctl spawn booted log stream --level debug --predicate 'subsystem CONTAINS \"com.sugow.eventshub.app\" OR process == \"EventsHub\"'",
    "db:push": "vp run --fail-if-no-match --filter @EventsHub/db db:push",
    "db:studio": "vp run --fail-if-no-match --filter @EventsHub/db db:studio",
    "db:seed": "vp run --fail-if-no-match --filter @EventsHub/db db:seed",
    "db:generate": "vp run --fail-if-no-match --filter @EventsHub/db db:generate",
    "db:migrate": "vp run --fail-if-no-match --filter @EventsHub/db db:migrate",
    "db:start": "vp run --fail-if-no-match --filter @EventsHub/db db:start",
    "db:watch": "vp run --fail-if-no-match --filter @EventsHub/db db:watch",
    "db:stop": "vp run --fail-if-no-match --filter @EventsHub/db db:stop",
    "db:down": "vp run --fail-if-no-match --filter @EventsHub/db db:down",
    "check": "vp run -r check",
    "lint": "vp run -r lint",
    "format": "vp run -r format",
    "test": "vp run -r test",
    "prepare": "vp config --no-agent --hooks-dir .vite-hooks",
    "secrets:scan": "gitleaks git --redact --verbose",
    "secrets:scan:staged": "gitleaks git --pre-commit --redact --staged --verbose"
  },
  "dependencies": {
    "@EventsHub/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@EventsHub/config": "workspace:*",
    "@types/bun": "catalog:",
    "@voidzero-dev/vite-plus-core": "^0.2.9",
    "typescript": "^6.0.3",
    "vite-plus": "^0.2.9"
  },
  "overrides": {
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "kysely": "0.28.17",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.2.9",
    "vitest": "4.1.10"
  },
  "packageManager": "bun@1.3.14"
}
