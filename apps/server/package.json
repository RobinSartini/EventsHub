{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "test": "vitest run --dir src --passWithNoTests",
    "lint": "vp lint --no-error-on-unmatched-pattern",
    "format": "vp fmt",
    "check": "vp check --no-error-on-unmatched-pattern",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@EventsHub/api": "workspace:*",
    "@EventsHub/auth": "workspace:*",
    "@EventsHub/db": "workspace:*",
    "@EventsHub/env": "workspace:*",
    "@anthropic-ai/sdk": "^0.110.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@hono/trpc-server": "^0.4.2",
    "@react-email/components": "^1.0.12",
    "@sentry/node": "^10.70.0",
    "@sentry/profiling-node": "^10.70.0",
    "@trpc/server": "catalog:",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "better-auth": "catalog:",
    "bullmq": "^5.81.2",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "i18next": "catalog:",
    "ioredis": "^5.11.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "catalog:",
    "react-email": "^6.11.0",
    "resend": "^6.32.0",
    "stripe": "catalog:",
    "typesense": "^3.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@EventsHub/config": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "jsdom": "catalog:",
    "pino-pretty": "^13.1.3",
    "playwright": "catalog:",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "catalog:"
  }
}
