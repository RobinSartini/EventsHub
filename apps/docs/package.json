{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 4000",
    "build": "fumadocs-mdx && next build",
    "start": "next start",
    "check-types": "fumadocs-mdx && tsc --noEmit",
    "lint": "vp lint --no-error-on-unmatched-pattern",
    "format": "vp fmt",
    "check": "vp check --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "fumadocs-core": "^16.15.4",
    "fumadocs-mdx": "^15.4.6",
    "fumadocs-ui": "^16.15.4",
    "next": "^16.3.8",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "postcss": "^8.5.15",
    "tailwindcss": "catalog:",
    "typescript": "^6.0.3"
  }
}
